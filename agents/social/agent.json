{
  "$schema": "../../schemas/agent.schema.json",
  "id": "social",
  "mode": "persistent",
  "purpose": "Orchestrate selective Social Skills and read-only brand/runtime context to diagnose, prioritise, plan, develop, critique, and recommend social growth work for controlled human review.",
  "inputs": [
    "skills/social",
    "brands/{brand_id}/brand-os",
    "brands/{brand_id}/operating-context",
    "brands/{brand_id}/channels/assets",
    "brands/{brand_id}/history/social-history",
    "brands/{brand_id}/evidence",
    "task-objective"
  ],
  "writes": [
    "brands/{brand_id}/work-in-progress",
    "brands/{brand_id}/evidence/observations"
  ],
  "forbidden_writes": [
    "brands/{brand_id}/brand-os",
    "brands/{brand_id}/governance/approved-learnings",
    "skills/social",
    "external-platforms"
  ],
  "human_approval_required_for": [
    "publishing",
    "scheduling",
    "external messaging",
    "profile changes",
    "campaign activation",
    "paid promotion",
    "public factual claims using unconfirmed current data"
  ]
}
