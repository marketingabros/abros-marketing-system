{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abros.internal/schemas/content-portfolio.schema.json",
  "title": "CONTENT_PORTFOLIO",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "brand_id", "period", "strategy_reference", "portfolio_logic", "items", "repetition_review", "experiments", "constraints", "missing_evidence", "approval_status"],
  "properties": {
    "output_type": {"enum": ["CONTENT_PORTFOLIO", "CONTENT_PLAN"]},
    "brand_id": {"type": "string"},
    "period": {"type": "string"},
    "strategy_reference": {"type": "string"},
    "portfolio_logic": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "content_job", "customer_behaviour", "concept_or_territory", "format_hypothesis", "why_now", "success_signal", "dependencies"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "content_job": {"type": "string"},
          "customer_behaviour": {"type": "string"},
          "concept_or_territory": {"type": "string"},
          "format_hypothesis": {"type": "string"},
          "why_now": {"type": "string"},
          "success_signal": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "repetition_review": {"type": "object", "required": ["recent_fingerprints_checked", "intentional_repetition", "fatigue_risks"], "properties": {"recent_fingerprints_checked": {"type": "boolean"}, "intentional_repetition": {"type": "array", "items": {"type": "string"}}, "fatigue_risks": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "experiments": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "approval_status": {"const": "DRAFT_REQUIRES_HUMAN_APPROVAL"}
  }
}
