{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abros.internal/schemas/instagram-production-brief.schema.json",
  "title": "INSTAGRAM_PRODUCTION_BRIEF",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "brand_id", "content_job", "concept", "format_rationale", "sequence", "copy_visual_audio_roles", "cta", "rights_checks", "accessibility", "performance_hypothesis", "platform_facts_checked_at", "approval_status"],
  "properties": {
    "output_type": {"enum": ["REEL_BRIEF", "CAROUSEL_BRIEF", "STORY_SEQUENCE"]},
    "brand_id": {"type": "string"},
    "content_job": {"type": "string"},
    "concept": {"type": "string"},
    "format_rationale": {"type": "string"},
    "sequence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["position", "visual", "message", "purpose"], "properties": {"position": {"type": "integer", "minimum": 1}, "visual": {"type": "string"}, "message": {"type": "string"}, "purpose": {"type": "string"}, "audio": {"type": "string"}}, "additionalProperties": false}},
    "copy_visual_audio_roles": {"type": "string"},
    "cta": {"type": "string"},
    "rights_checks": {"type": "array", "items": {"type": "string"}},
    "accessibility": {"type": "array", "items": {"type": "string"}},
    "performance_hypothesis": {"type": "string"},
    "platform_facts_checked_at": {"type": "string"},
    "approval_status": {"const": "DRAFT_REQUIRES_HUMAN_APPROVAL"}
  }
}
