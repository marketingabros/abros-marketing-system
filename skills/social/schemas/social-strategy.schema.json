{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abros.internal/schemas/social-strategy.schema.json",
  "title": "SOCIAL_STRATEGY",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "brand_id", "decision_window", "business_objective", "customer_behaviour", "social_objective", "channel_role", "content_jobs", "measurement", "assumptions", "missing_evidence", "provenance", "approval_status"],
  "properties": {
    "output_type": {"const": "SOCIAL_STRATEGY"},
    "brand_id": {"type": "string", "minLength": 1},
    "decision_window": {"type": "string", "minLength": 1},
    "business_objective": {"type": "string", "minLength": 1},
    "customer_behaviour": {"type": "string", "enum": ["awareness", "consideration", "visit", "booking", "purchase", "repeat_behaviour", "community", "other_defined"]},
    "social_objective": {"type": "string", "minLength": 1},
    "channel_role": {"type": "string", "minLength": 1},
    "content_jobs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["job", "reason"], "properties": {"job": {"type": "string"}, "reason": {"type": "string"}, "journey_stage": {"type": "string"}}, "additionalProperties": false}},
    "measurement": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["level", "measure", "definition", "interpretation_limit"], "properties": {"level": {"enum": ["activity", "output", "audience_response", "outcome", "impact"]}, "measure": {"type": "string"}, "definition": {"type": "string"}, "interpretation_limit": {"type": "string"}}, "additionalProperties": false}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "approval_status": {"const": "DRAFT_REQUIRES_HUMAN_APPROVAL"}
  }
}
