{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abros.internal/schemas/module-guidance.schema.json",
  "title": "SOCIAL_MODULE_GUIDANCE",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "module_id", "applies_to", "mechanics", "conversion_events", "constraints", "proof_needs", "measurement_implications", "excluded_assumptions", "missing_evidence", "provenance"],
  "properties": {
    "output_type": {"enum": ["BUSINESS_MODEL_GUIDANCE", "VERTICAL_GUIDANCE"]},
    "module_id": {"type": "string"},
    "applies_to": {"type": "string"},
    "mechanics": {"type": "array", "items": {"type": "string"}},
    "conversion_events": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "proof_needs": {"type": "array", "items": {"type": "string"}},
    "measurement_implications": {"type": "array", "items": {"type": "string"}},
    "excluded_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}}
  }
}
